FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /bin/

WORKDIR /app
COPY sidecar/laya/pyproject.toml sidecar/laya/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY sidecar/laya/src ./src
RUN uv sync --locked --no-dev

RUN useradd --create-home --shell /usr/sbin/nologin laya \
    && mkdir -p /home/laya/.cache/huggingface \
    && chown -R laya:laya /home/laya
USER laya

ENV PATH="/app/.venv/bin:${PATH}" \
    HF_HOME=/home/laya/.cache/huggingface

EXPOSE 8091
CMD ["uvicorn", "mindctl_laya.app:app", "--host", "0.0.0.0", "--port", "8091"]
