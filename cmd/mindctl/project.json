{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "mindctl",
  "projectType": "application",
  "sourceRoot": "cmd/mindctl",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/mindctl"],
      "options": {
        "command": "mkdir -p dist/apps/mindctl && go build -trimpath -o dist/apps/mindctl/mindctl ./cmd/mindctl"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "go test ./cmd/mindctl" }
    }
  }
}
